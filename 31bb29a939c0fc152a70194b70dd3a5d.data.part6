    u_xlat12.w = u_xlat11.x;
    u_xlat12 = u_xlat3.yyyy * u_xlat12;
    u_xlat13.x = u_xlat5.y;
    u_xlat13.y = u_xlat6.y;
    u_xlat13.z = u_xlat7.y;
    u_xlat13.w = u_xlat11.y;
    u_xlat13 = u_xlat3.yyyy * u_xlat13;

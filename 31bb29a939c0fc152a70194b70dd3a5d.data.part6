layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
void main()
{
    u_xlatb0 = gl_GlobalInvocationID.x>=g_VertCount;
    if(u_xlatb0){
        return;
    }
    u_xlat0 = vec4(uintBitsToFloat(inVertices_buf[gl_GlobalInvocationID.x].value[(0 >> 2) + 3]), uintBitsToFloat(inVertices_buf[gl_GlobalInvocationID.x].value[(0 >> 2) + 0]), uintBitsToFloat(inVertices_buf[gl_GlobalInvocationID.x].value[(0 >> 2) + 1]), uintBitsToFloat(inVertices_buf[gl_GlobalInvocationID.x].value[(0 >> 2) + 2]));

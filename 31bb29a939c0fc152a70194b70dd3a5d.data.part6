vec3 u_xlat3;
ivec2 u_xlati4;
vec3 u_xlat5;
vec4 u_xlat6;
int u_xlati7;
int u_xlati21;
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
void main()
{
    u_xlatb0 = gl_GlobalInvocationID.x>=g_VertCount;
    if(u_xlatb0){
        return;
    }
    u_xlati0.x = int(gl_GlobalInvocationID.x) + int(g_FirstVert);
    u_xlati7 = u_xlati0.x * 40;
    u_xlat1 = vec4(uintBitsToFloat(inBlendShapeVertices_buf[(u_xlati7 >> 2) + 0]), uintBitsToFloat(inBlendShapeVertices_buf[(u_xlati7 >> 2) + 1]), uintBitsToFloat(inBlendShapeVertices_buf[(u_xlati7 >> 2) + 2]), uintBitsToFloat(inBlendShapeVertices_buf[(u_xlati7 >> 2) + 3]));
    u_xlati0.xy = u_xlati0.xx * ivec2(40, 40) + ivec2(16, 32);
    u_xlat2 = vec4(uintBitsToFloat(inBlendShapeVertices_buf[(u_xlati0.x >> 2) + 0]), uintBitsToFloat(inBlendShapeVertices_buf[(u_xlati0.x >> 2) + 1]), uintBitsToFloat(inBlendShapeVertices_buf[(u_xlati0.x >> 2) + 2]), uintBitsToFloat(inBlendShapeVertices_buf[(u_xlati0.x >> 2) + 3]));

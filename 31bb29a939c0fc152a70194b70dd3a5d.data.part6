    u_xlat3.xyz = vec3(uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat2.z)].value[(16 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat2.z)].value[(16 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat2.z)].value[(16 >> 2) + 2]));
    u_xlat4.xyz = vec3(uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat2.z)].value[(32 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat2.z)].value[(32 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat2.z)].value[(32 >> 2) + 2]));
    u_xlat5.xyw = vec3(uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat2.z)].value[(48 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat2.z)].value[(48 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat2.z)].value[(48 >> 2) + 2]));
